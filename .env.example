# Create a separate Supabase project and environment file for local, staging,
# and production. Publishable keys are safe for browser use; secret and
# service-role keys must never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TuwPG0ii88gscU3ZzCKIqA_g8pdRVXJ

# Server-only. Required for public availability checks; never add NEXT_PUBLIC_.
# Use the environment's Supabase secret key (legacy service-role keys also work).
SUPABASE_SECRET_KEY=sb_secret_replace_for_each_environment

# Set this to the canonical URL for the environment being deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Connect Standard direct charges. The publishable key is browser-safe;
# the secret key and webhook signing secret must remain server-only.
STRIPE_SECRET_KEY=sk_test_replace_for_each_environment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_for_each_environment
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_for_each_environment

# Local-only Phase 6 escape hatch. Keep false outside ignored .env.local.
STRIPE_LOCAL_PLATFORM_FALLBACK=false
